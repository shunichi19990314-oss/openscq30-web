{
  "name": "openscq30-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web port of OpenSCQ30 (Soundcore P30i / A3959) using the Web Serial API over Bluetooth RFCOMM",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "screenshots": "npm run build && npm run build:preview && node scripts/screenshots.mjs",
    "build:preview": "vite build --config vite.preview.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-serial": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "GPL-3.0-or-later"
}
